#. Plugin Name of the plugin
#: zw-pangram.php
msgid "ZuidWest Pangram"
msgstr "ZuidWest Pangram"

#. Plugin URI of the plugin
#: zw-pangram.php
msgid "https://github.com/oszuidwest/zw-pangram"
msgstr "https://github.com/oszuidwest/zw-pangram"

#. Description of the plugin
#: zw-pangram.php
msgid ""
"Scores existing posts with the Pangram Labs AI text detector via its bulk "
"API and reports the results in wp-admin."
msgstr ""
"Beoordeelt bestaande berichten met de AI-tekstdetector van Pangram Labs via "
"de bulk-API en toont de resultaten in wp-admin."

#. Author of the plugin
#: zw-pangram.php
msgid "Streekomroep ZuidWest"
msgstr "Streekomroep ZuidWest"

