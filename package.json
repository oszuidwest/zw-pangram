{
    "name": "zw-pangram",
    "private": true,
    "description": "Development tooling for the ZuidWest Pangram plugin (wp-env, Playground, JS lint).",
    "license": "GPL-2.0-or-later",
    "scripts": {
        "lint": "npm run lint:js",
        "lint:js": "wp-scripts lint-js \"assets/**/*.js\"",
        "playground": "wp-playground-cli server --port=9400 --workers=1 --php=8.3 --wp=7.1 --mount=./:/wordpress/wp-content/plugins/zw-pangram --blueprint=./playground/blueprint.json",
        "playground:smoke": "wp-playground-cli run-blueprint --php=8.3 --wp=7.1 --mount=./:/wordpress/wp-content/plugins/zw-pangram --blueprint=./playground/blueprint.json",
        "env:start": "wp-env start --config=.wp-env.tests.json",
        "env:stop": "wp-env stop --config=.wp-env.tests.json",
        "env:destroy": "wp-env destroy --config=.wp-env.tests.json",
        "env:composer": "wp-env run cli --config=.wp-env.tests.json --env-cwd=wp-content/plugins/zw-pangram composer install --no-interaction --prefer-dist",
        "test:php": "wp-env run cli --config=.wp-env.tests.json --env-cwd=wp-content/plugins/zw-pangram vendor/bin/phpunit",
        "bench:seed": "wp-env run cli --config=.wp-env.tests.json --env-cwd=wp-content/plugins/zw-pangram wp eval-file scripts/seed-fixtures.php 50000",
        "bench:run": "wp-env run cli --config=.wp-env.tests.json --env-cwd=wp-content/plugins/zw-pangram wp eval-file scripts/benchmark-results.php",
        "make-pot": "scripts/pot.sh"
    },
    "devDependencies": {
        "@wordpress/env": "^11.15.0",
        "@wordpress/scripts": "^35.0.0",
        "@wp-playground/cli": "^3.1.53"
    }
}
