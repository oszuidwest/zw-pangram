{
    "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
    "files": {
        "includes": ["assets/**"]
    },
    "linter": {
        "rules": {
            "correctness": {
                "noUndeclaredVariables": "error"
            }
        }
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        },
        "globals": ["jQuery", "wp", "zwPangram"]
    }
}
